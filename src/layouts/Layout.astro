---
import BaseHead from '../components/BaseHead.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
}

const { title, description, image, type, publishedDate } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {title} {description} {image} {type} {publishedDate} />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="logo">gate</a>
        <nav>
          <a href="/docs">Docs</a>
          <a href="/au-nz-pack">AU/NZ Pack</a>
          <a href="/blog">Blog</a>
          <a href="https://github.com/GaaraZhu/gate" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.gzhu.co.nz/contact.html" class="cta" target="_blank" rel="noopener">Get certified</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          gate is MIT-licensed open source by
          <a href="https://www.gzhu.co.nz" target="_blank" rel="noopener">GZhu Limited</a>.
          AI Data Governance consulting for AU/NZ regulated organisations.
        </p>
        <p class="footer-links">
          <a href="https://github.com/GaaraZhu/gate" target="_blank" rel="noopener">GitHub</a>
          ·
          <a href="/llms.txt">llms.txt</a>
          ·
          <a href="/sitemap-index.xml">Sitemap</a>
        </p>
      </div>
    </footer>
  </body>
</html>
