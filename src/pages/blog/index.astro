---
import Layout from '../../layouts/Layout.astro';

const posts = [
  {
    href: 'https://gaarazhu.github.io/introducing-gate/',
    title: 'gate: a deterministic PII boundary between your data and AI agents',
    date: '2026',
    description: 'The original introduction to gate — the problem it solves, the two-layer detection pipeline, why deterministic regex beats LLM-based redaction, and how it integrates with Claude Code, Cursor, Copilot, and MCP servers.',
    external: true,
  },
];
---

<Layout
  title="Blog — gate"
  description="Articles on AI agent data privacy, PII redaction, and AU/NZ compliance from the team behind gate."
>
  <section class="page-hero">
    <div class="container">
      <h1>Blog</h1>
      <p>AI agent data privacy, PII detection, and AU/NZ compliance.</p>
    </div>
  </section>

  <div class="container blog-list">
    {posts.map(post => (
      <article class="post-card">
        <div class="post-meta">{post.date}</div>
        <h3>
          <a
            href={post.href}
            target={post.external ? '_blank' : undefined}
            rel={post.external ? 'noopener' : undefined}
          >
            {post.title}{post.external ? ' ↗' : ''}
          </a>
        </h3>
        <p>{post.description}</p>
      </article>
    ))}
  </div>
</Layout>
